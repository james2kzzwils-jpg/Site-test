## Place at /opt/epov/site/.env.local on the server.
## Do NOT commit your real .env.local — it stays on the server only.

## Supabase
NEXT_PUBLIC_SUPABASE_URL=https://awrnfgaqclfgrunetuhq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

## (Optional) Public site URL used in metadata, og:image, etc.
## Not strictly required for the portal to function, but
## fill it in once you know the canonical URL.
NEXT_PUBLIC_SITE_URL=https://aepovcg.online

## Resend — marketing-site contact form sink.
## Without this, /api/contact still saves submissions to Supabase
## but no email gets sent.
RESEND_API_KEY=re_REPLACE_ME
CONTACT_INBOX_EMAIL=cggeneralistandrey@gmail.com
CONTACT_FROM_EMAIL="EPOV Creative Labs <onboarding@resend.dev>"
