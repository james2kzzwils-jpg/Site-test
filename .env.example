# Supabase project URL and keys for the portal.
# Copy to .env.local for local dev; set the same values in Vercel
# (Project → Settings → Environment Variables) for production.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Resend — used by /api/contact to forward marketing-site form
# submissions. The form still saves to Supabase if this is unset,
# but no email goes out.
RESEND_API_KEY=re_xxx
# Optional: override the inbox the form notifications land in.
CONTACT_INBOX_EMAIL=cggeneralistandrey@gmail.com
# Optional: override the From address. Defaults to Resend's sandbox
# sender (onboarding@resend.dev) which works without domain
# verification when sending to your own verified email.
CONTACT_FROM_EMAIL="EPOV Creative Labs <onboarding@resend.dev>"
